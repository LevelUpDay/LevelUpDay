{
  "manifest_version": 3,
  "name": "LevelUpDay Focusgate",
  "short_name": "Focusgate",
  "version": "0.3.0",
  "description": "LevelUpDay Focusgate: saytlarni bloklash, YouTube Shorts / Instagram Reels'ni o'chirish va saytlarda o'tgan vaqtni hisoblash.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "LevelUpDay Focusgate" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "tabs", "alarms", "idle"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://*.instagram.com/*", "*://*.tiktok.com/*", "*://*.facebook.com/*"],
      "js": ["insite.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [{ "resources": ["blocked.html"], "matches": ["<all_urls>"] }]
}
